# Claude 2026-09-21: hourly stale usenet_resume_state cleanup
# Reason: keep dead resume mirrors from accumulating on the 8G sakms_db LUN
# Troubleshooting: sakms-db unhealthy / healthz 503 after large NZB resume writes
# Review if: code stops per-segment SaveResume (interval can loosen)
# Related: sakms-resume-vacuum.service

[Unit]
Description=Run sakms resume-state vacuum hourly

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
Persistent=true
Unit=sakms-resume-vacuum.service

[Install]
WantedBy=timers.target
